# Supabase public project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public API key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave SECRETA do servidor (nunca com NEXT_PUBLIC). Supabase -> Project Settings -> API Keys.
# Usada só nas rotas /api (excluir/desativar visitantes, registrar acessos, logs de segurança).
SUPABASE_SERVICE_ROLE_KEY=

# Endereço oficial do site (links de compartilhamento e de redefinir senha). Ex.: https://seu-dominio.com.br
NEXT_PUBLIC_SITE_URL=

# Senha da limpeza diária via Vercel Cron (/api/cron/limpeza). Texto longo e aleatório.
CRON_SECRET=

# (Opcional) segredo para gerar os "hashes" de IP/e-mail. Se vazio, usa a chave do servidor.
HASH_SECRET=
