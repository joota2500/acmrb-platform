# Supabase public project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public API key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave SECRETA do servidor (nunca com NEXT_PUBLIC). Supabase -> Project Settings -> API Keys.
# Usada só nas rotas /api (excluir/desativar visitantes, registrar acessos, logs de segurança).
SUPABASE_SERVICE_ROLE_KEY=

# Endereço oficial do site (links de compartilhamento e de redefinir senha). Ex.: https://seu-dominio.com.br
NEXT_PUBLIC_SITE_URL=

# Senha da limpeza diária via Vercel Cron (/api/cron/limpeza). Texto longo e aleatório.
CRON_SECRET=

# Segredo para gerar os "hashes" de IP/e-mail (texto aleatório longo). Se vazio, usa a chave do servidor.
HASH_SECRET=

# Código de verificação do Google Search Console (só o valor do "content" da meta tag). Opcional.
GOOGLE_SITE_VERIFICATION=

# CAPTCHA "não sou um robô" (Cloudflare Turnstile) no login, cadastro e recuperação.
# É a chave PÚBLICA (Site Key). Vazio = captcha desligado. A chave secreta vai só no painel do Supabase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Endereços secretos das telas de login dos administradores (lidos pelo middleware).
# Escolha caminhos difíceis de adivinhar e NÃO coloque os valores reais aqui nem no GitHub.
ROTA_SECRETA_ADMIN=
ROTA_SECRETA_DEUS=

# Sentry (avisos de erro em produção). Vazio = desligado.
# Pegue o DSN em sentry.io → seu projeto → Settings → Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Opcional: DSN só para o servidor (se vazio, usa o de cima)
SENTRY_DSN=
